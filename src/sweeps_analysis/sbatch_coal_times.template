#!/bin/bash
#SBATCH --job-name={job_name}
#SBATCH --account={account}
#SBATCH --partition={partition}
#SBATCH --array=0-{n_tasks_minus_1}
#SBATCH --cpus-per-task=1
#SBATCH --mem={mem}
#SBATCH --time={time}
#SBATCH --output=slurm_runs/coal_times/{job_name}_%A_%a.out
#SBATCH --error=slurm_runs/coal_times/{job_name}_%A_%a.err

# Stage 0 for the OOA3 sweeps: one msprime coalescent-time integration per t_split.
# Auto-generated by render_coal_times_sbatch.py -- regenerate rather than hand-editing
# the --array bound.
mkdir -p slurm_runs/coal_times

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

source /software/bin/miniconda3/etc/profile.d/conda.sh
conda activate /project/jnovembre/afselim/pca_rmt
python src/sweeps_analysis/precompute_coal_times.py \
    --simdir {simdir} \
    --task-index "${{SLURM_ARRAY_TASK_ID}}"
