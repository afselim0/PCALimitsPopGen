#!/bin/bash
#SBATCH --job-name=sum_{group}
#SBATCH --account={account}
#SBATCH --partition={partition}
#SBATCH --cpus-per-task=16
#SBATCH --mem=16G
#SBATCH --time=04:00:00
#SBATCH --output=slurm_runs/summarise/sum_{group}_%j.out
#SBATCH --error=slurm_runs/summarise/sum_{group}_%j.err

# Stage 3: fit every curve of one summary group and write its summary files.
# Auto-generated by sbatch.py.
#
# The monotone sweeps are fitted by threshold_fit (numpy/scipy); each curve costs a
# replicate bootstrap that refits the whole model, which is what the cpus are for. Only the
# concave recent-split sweeps still go through R's scam via rpy2, and R is on PATH only
# inside the env -- summarise.py checks for it and exits loudly rather than emitting empty
# fits.
mkdir -p slurm_runs/summarise
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

source /software/bin/miniconda3/etc/profile.d/conda.sh
conda activate /project/jnovembre/afselim/pca_rmt
python src/sweeps_analysis/summarise.py {sweep_dirs} --out {out} \
    --n-jobs ${{SLURM_CPUS_PER_TASK:-16}}
